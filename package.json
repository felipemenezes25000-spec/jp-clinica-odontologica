{
  "name": "jp-clinica-odontologica-award-final",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "tour:build": "npm --prefix apresentacao run build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integracao": "vitest run --config vitest.integracao.config.ts",
    "schema:aplicar": "node scripts/aplicar-schema.mjs",
    "schema:status": "node scripts/schema-status.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:site": "playwright test --config playwright.publico.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-start": "^1.168.52",
    "@tanstack/router-plugin": "^1.168.23",
    "lucide-react": "^0.575.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
